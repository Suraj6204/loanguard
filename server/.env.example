# ============================================
# LoanGuard Server — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- MongoDB ----------
# Local:   mongodb://127.0.0.1:27017/loanguard
# Atlas:   mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/loanguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/loanguard

# ---------- JWT ----------
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=24h

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3000

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=50
